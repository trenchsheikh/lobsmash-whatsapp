# Gemini (Interactions API) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kapso WhatsApp (see SANDBOX.md or Kapso docs)
KAPSO_API_KEY=
# Optional overrides
# KAPSO_WHATSAPP_BASE_URL=https://api.kapso.ai/meta/whatsapp
# META_GRAPH_VERSION=v24.0

# Webhook HMAC (Kapso phone-number webhook → your HTTPS URL)
# Raw body must be verified with X-Webhook-Signature
KAPSO_WEBHOOK_SECRET=

# From `kapso whatsapp numbers resolve` — required for sending + media download
WHATSAPP_PHONE_NUMBER_ID=

# Optional: Meta Cloud manual webhook verification (hub.verify_token)
# META_VERIFY_TOKEN=

# SQLite database file (default: ./data/lobsmash.db)
# DATABASE_URL=file:./data/lobsmash.db
