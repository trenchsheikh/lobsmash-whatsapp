# Gemini (Interactions API) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Set to 1 to disable server-side interaction chaining (debug / stuck sessions)
# GEMINI_DISABLE_INTERACTION_CHAIN=
# Optional: first model to try when Interactions API fails (default: gemini-2.5-flash)
# GEMINI_GENERATE_FALLBACK_MODEL=

# Wassist — https://docs.wassist.app/api-reference/introduction
# API key (Settings → API Keys): for programmatic agent/API use, not required for webhook-only.
WASSIST_API_KEY=
# Optional: HMAC-SHA256 hex of raw body must match X-Webhook-Signature (if your setup signs webhooks).
WASSIST_WEBHOOK_SECRET=
# Optional: instead of HMAC, require a custom header (name + value) on inbound POSTs.
# WASSIST_WEBHOOK_HEADER_NAME=
# WASSIST_WEBHOOK_HEADER_VALUE=
# Optional: override REST base (default https://backend.wassist.app/api/v1)
# WASSIST_API_BASE=

# Pro upgrade — video gate (see https://docs.wassist.app/api-reference/conversations/messages/send)
# LOBSMASH_PRO_URL=https://lobsmash.com
# WhatsApp template name (published in Wassist/Meta). If set, webhook returns type "template" per Wassist.
# LOBSMASH_VIDEO_PRO_TEMPLATE_NAME=lobsmash_pro_video
# Optional JSON for template variables (body/header/buttons) — must match your template placeholders.
# LOBSMASH_VIDEO_PRO_TEMPLATE_VARIABLES_JSON={"body":["https://lobsmash.com"]}

# Playtomic Third Party API — https://third-party.playtomic.io/endpoints/auth/
# Credentials from Playtomic Manager → Settings → Developer tools (venue/chain).
# PLAYTOMIC_CLIENT_ID=
# PLAYTOMIC_CLIENT_SECRET=
# Optional: default https://thirdparty.playtomic.io
# PLAYTOMIC_API_BASE=
# Optional: GET path to verify API access (e.g. an endpoint your org exposes)
# PLAYTOMIC_API_PROBE_PATH=

# Supabase PostgreSQL (pooler URL from Project Settings → Database)
# Session mode: port 5432. Optional: DATABASE_POOL_MAX=10 for serverless.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Optional: default is relaxed SSL verify for Supabase + Vercel (avoids SELF_SIGNED_CERT_IN_CHAIN). Set true for strict CA verify.
# DATABASE_SSL_REJECT_UNAUTHORIZED=

# Optional — Meta subscription verify (only if something still calls hub.mode on this URL)
# META_VERIFY_TOKEN=
